{
  "name": "jurassic-domination",
  "version": "0.5.0",
  "description": "A dinosaur evolution survival roguelite, from fragile egg to mythic apex.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Evan Bartkowski",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "qa": "node scripts/qa.mjs",
    "qa:desktop": "node scripts/desktop-qa.mjs",
    "qa:portable": "node scripts/portable-qa.mjs",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64",
    "qa:collections": "node scripts/qa-collections.mjs",
    "qa:wild": "node scripts/qa-wild.mjs",
    "art:portraits": "node scripts/render-portraits.mjs",
    "qa:progression": "node scripts/qa-progression.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "com.evanbartkowski.jurassicdomination",
    "productName": "Jurassic Domination",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "public/assets/icon.ico"
    },
    "portable": {
      "artifactName": "Jurassic Domination-${version}-portable.${ext}"
    }
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
